<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>DE Campaign List View</masterLabel>
    <description>Velo Motors Partner Hub style list view of active Campaigns; each row opens the campaign detail page.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="heading" type="String" label="Heading" default="All Campaigns" />
            <property name="maxRows" type="Integer" label="Max Rows" default="50" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>

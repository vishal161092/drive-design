<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>DE Quick Send Message</masterLabel>
    <description>Velo Motors Partner Hub style record-home layout for a Quick Send Message (Free Form - SMS) with Audience, Bulk Send Jobs, Quick Send Setting, and Scheduled Send cards.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordLabel" type="String" label="Record Type Label" default="Quick Send Message"/>
            <property name="recordTitle" type="String" label="Record Title" default="Free Form - SMS"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
